# Copie para .env e preencha com os valores do SEU projeto (Lovable Cloud / Supabase).
# Use apenas a chave pública (anon/publishable). NUNCA coloque a service_role no front-end.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Banco PostgreSQL local (docker-compose.yml)
DB_USER=
DB_PASSWORD=
DB_NAME=
# Chave usada pelo pgcrypto para criptografar CPF (configurada no banco como app.chave_cpf)
APP_CHAVE_CPF=
