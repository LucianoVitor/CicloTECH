{
  "expo": {
    "name": "CicloTECH",
    "slug": "ciclotech",
    "scheme": "ciclotech",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030712",
    "primaryColor": "#3B82F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciclotech.app"
    },
    "android": {
      "package": "com.ciclotech.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O CicloTECH usa suas fotos para mostrar o equipamento e a sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
